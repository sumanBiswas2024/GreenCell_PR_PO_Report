<mvc:View controllerName="Z_PR_PO_Report_GC.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:cc="sap.suite.ui.commons" xmlns:table="sap.ui.table" displayBlock="true" height="100%">
	<App>
		<pages>
			<Page id="page" showHeader="false" enableScrolling="true" class="prpoPage">
				<content>
					<VBox class="prpoRoot" width="100%">
						<!-- Page title -->
						<VBox class="prpoPageTitle">
							<Title text="PR / PO / GRN Procurement Dashboard" level="H1" titleStyle="H2"/>
							<Text text="Compare purchase requisition, purchase order and goods receipt quantities by period." class="prpoSubtitle"/>
						</VBox>
						<!-- Messages (validation / errors / info) with optional Retry -->
						<MessageStrip id="pageMessage" text="" type="Information" showIcon="true" visible="false" class="prpoMessage">
							<link><Link text="Retry" visible="{screen1>/canRetry}" press="onRetry"/></link>
						</MessageStrip>
						<!-- PANEL 0: Selection Criteria (separate from the analysis panel) -->
						<Panel id="selectionPanel" class="prpoCard prpoSelectionPanel" expandable="false" backgroundDesign="Solid" accessibleRole="Region">
							<headerToolbar>
								<Toolbar class="prpoCardHeader" style="Clear">
									<core:Icon src="sap-icon://filter" class="prpoCardIcon"/>
									<Title text="Selection Criteria" level="H2"/>
								</Toolbar>
							</headerToolbar>
							<content>
								<!-- Bare flex row: fields grow/wrap by width, so nothing gets squeezed -->
								<HBox class="prpoFilterBar" wrap="Wrap" renderType="Bare" alignItems="End">
									<!--<VBox >-->
									<!--	<Label text="Report Type" required="false" labelFor="reportType"/>-->
									<!--	<SegmentedButton id="reportType" width="100%" selectedKey="{screen1>/selection/type}" selectionChange="onReportTypeChange">-->
									<!--		<items>-->
												<!--<SegmentedButtonItem key="M" text="Month"/>-->
												<!--<SegmentedButtonItem key="Q" text="Quarter"/>-->
									<!--			<SegmentedButtonItem key="Y" text="Year"/>-->
									<!--		</items>-->
									<!--	</SegmentedButton>-->
									<!--</VBox>-->
									<VBox class="prpoField prpoFieldPlant">
										<Label text="Plant" required="true" labelFor="plantSelect"/>
										<Input id="plantSelect" width="100%" placeholder="Enter plant code or use value help" value="{screen1>/selection/plant}"
											showValueHelp="true" showSuggestion="true" filterSuggests="true" startSuggestion="1" suggestionItemSelected="onPlantSuggestionSelected"
											valueHelpRequest="onPlantValueHelp" busy="{screen1>/plantsBusy}" busyIndicatorDelay="0" valueState="{screen1>/valueState/plant}"
											valueStateText="{screen1>/valueText/plant}" change="onPlantChange">
											<suggestionItems>
												<core:Item key="{screen1>Plant}" text="{= ${screen1>Plant} + ' – ' + ${screen1>PlantName} }"/>
											</suggestionItems>
										</Input>
									</VBox>
									<VBox class="prpoField prpoFieldYear">
										<Label text="Year" required="true" labelFor="yearSelect"/>
										<Select id="yearSelect" width="100%" selectedKey="{screen1>/selection/year}" items="{screen1>/years}"
											valueState="{screen1>/valueState/year}" valueStateText="{screen1>/valueText/year}" change="onYearChange">
											<core:Item key="{screen1>key}" text="{screen1>text}"/>
										</Select>
									</VBox>
									<VBox class="prpoField prpoFieldPeriod" visible="{= ${screen1>/selection/type} !== 'Y' }">
										<Label text="{screen1>/ui/subPeriodLabel}" required="true" labelFor="subPeriodSelect"/>
										<Select id="subPeriodSelect" width="100%" forceSelection="false" selectedKey="{screen1>/selection/subPeriod}" items="{screen1>/subPeriods}"
											valueState="{screen1>/valueState/subPeriod}" valueStateText="{screen1>/valueText/subPeriod}" change="onSubPeriodChange">
											<core:Item key="{screen1>key}" text="{screen1>text}" enabled="{screen1>enabled}"/>
										</Select>
									</VBox>
									<HBox class="prpoField prpoFieldActions" renderType="Bare">
										<Button id="getDataButton" text="Get Data" type="Emphasized" icon="sap-icon://play" enabled="{= !${screen1>/busy} }" press="onGetData"/>
										<Button id="resetButton" text="Reset" icon="sap-icon://reset" press="onReset"/>
									</HBox>
								</HBox>
							</content>
						</Panel>
						<!-- PANEL 1: Periodic Analysis – chart (50%) | table (50%) -->
						<Panel id="periodAnalysisPanel" class="prpoCard prpoAnalysisPanel" expandable="true" expanded="true" backgroundDesign="Solid"
							accessibleRole="Region">
							<headerToolbar>
								<Toolbar class="prpoCardHeader" style="Clear">
									<core:Icon src="sap-icon://vertical-bar-chart" class="prpoCardIcon"/>
									<Title text="PR / PO / GRN Quantity – Periodic Analysis" level="H2" wrapping="true"/>
									<ToolbarSpacer/>
									<ObjectStatus text="{screen1>/contextText}" state="Success" inverted="true" class="prpoDetailContextStatus"/>
								</Toolbar>
							</headerToolbar>
							<content>
								<VBox id="resultArea" class="prpoResultArea" busy="{screen1>/busy}" busyIndicatorDelay="0">
									<!-- Initial state -->
									<VBox class="prpoEmpty" alignItems="Center" visible="{= !${screen1>/searched} }">
										<core:Icon src="sap-icon://vertical-bar-chart" size="2.5rem" class="prpoEmptyIcon"/>
										<Title text="Ready when you are" level="H3"/>
										<Text text="Choose plant, report type and period, then select Get Data." textAlign="Center"/>
									</VBox>
									<!-- No data state -->
									<VBox class="prpoEmpty" alignItems="Center" visible="{screen1>/showNoData}">
										<core:Icon src="sap-icon://notification-2" size="2.5rem" class="prpoEmptyIcon"/>
										<Title text="No data found" level="H3"/>
										<Text text="There are no PR / PO / GRN quantities for the selected criteria. Try another plant or period." textAlign="Center"/>
									</VBox>
									<!-- 50 : 50 split. Stacks to one column when the panel is narrow -->
									<HBox class="prpoSplit" wrap="Wrap" renderType="Bare" alignItems="Start" visible="{screen1>/hasData}">
										<!-- LEFT 50%: chart -->
										<VBox class="prpoSplitCol prpoChartCol">
											<Title text="PR / PO / GRN Quantity" level="H3" class="prpoSectionTitle"/>
											<ScrollContainer id="chartScrollContainer" width="100%" height="{screen1>/ui/chartViewportHeight}" horizontal="true" vertical="false"
												focusable="true" class="prpoChartViewport">
												<HBox id="chartCanvas" width="{screen1>/ui/chartWidth}" height="100%" renderType="Bare" class="prpoChartCanvas">
													<cc:ChartContainer id="chartContainer" class="prpoChartContainer" autoAdjustHeight="true" showFullScreen="true" showZoom="true"
														showPersonalization="false" showLegend="false" showLegendButton="false">
														<cc:content>
															<cc:ChartContainerContent icon="sap-icon://vertical-bar-chart" title="PR / PO / GRN quantities">
																<cc:content>
																	<viz:VizFrame id="quantityChart" vizType="column" width="100%" height="{screen1>/ui/chartHeight}" uiConfig="{applicationSet:'fiori'}"
																		selectData="onChartSelect" renderComplete="onChartRenderComplete">
																		<viz:dataset>
																			<viz.data:FlattenedDataset data="{screen1>/periods}">
																				<viz.data:dimensions>
																					<viz.data:DimensionDefinition name="Period" value="{screen1>period}"/>
																				</viz.data:dimensions>
																				<viz.data:measures>
																					<viz.data:MeasureDefinition name="PR Quantity" value="{screen1>PRQty}"/>
																					<viz.data:MeasureDefinition name="PO Quantity" value="{screen1>POQty}"/>
																					<viz.data:MeasureDefinition name="GRN Quantity" value="{screen1>GRNQty}"/>
																				</viz.data:measures>
																			</viz.data:FlattenedDataset>
																		</viz:dataset>
																		<viz:feeds>
																			<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PR Quantity,PO Quantity,GRN Quantity"/>
																			<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Period"/>
																		</viz:feeds>
																	</viz:VizFrame>
																</cc:content>
															</cc:ChartContainerContent>
														</cc:content>
													</cc:ChartContainer>
												</HBox>
											</ScrollContainer>
											<HBox class="prpoExternalLegend" justifyContent="Center" alignItems="Center" wrap="Wrap">
												<HBox class="prpoLegendItem" alignItems="Center"><core:Icon src="sap-icon://circle-task-2" class="prpoLegendSwatch prpoLegendPR"/><Text text="PR Quantity"/></HBox>
												<HBox class="prpoLegendItem" alignItems="Center"><core:Icon src="sap-icon://circle-task-2" class="prpoLegendSwatch prpoLegendPO"/><Text text="PO Quantity"/></HBox>
												<HBox class="prpoLegendItem" alignItems="Center"><core:Icon src="sap-icon://circle-task-2" class="prpoLegendSwatch prpoLegendGRN"/><Text text="GRN Quantity"/></HBox>
											</HBox>
										</VBox>
										<!-- RIGHT 50%: table -->
										<VBox class="prpoSplitCol prpoTableCol">
											<Title text="Period-wise Quantity" level="H3" class="prpoSectionTitle"/>
											<ScrollContainer id="periodTableScroll" width="100%" height="{screen1>/ui/tableHeight}" vertical="true" horizontal="false" focusable="true"
												class="prpoTableScroll">
												<Table id="periodTable" items="{screen1>/periods}" mode="SingleSelectLeft" includeItemInSelection="true" selectionChange="onTableSelect"
													class="prpoTable" noDataText="No periods to display" growing="false">
													<columns>
														<Column><Text text="Period"/></Column>
														<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Date Range"/></Column>
														<Column hAlign="End"><Text text="PR Quantity"/></Column>
														<Column hAlign="End"><Text text="PO Quantity"/></Column>
														<Column hAlign="End"><Text text="GRN Quantity"/></Column>
													</columns>
													<items>
														<ColumnListItem>
															<cells>
																<ObjectIdentifier title="{screen1>period}"/>
																<Text text="{screen1>RangeText}"/>
																<ObjectNumber
																	number="{path:'screen1>PRQty', type:'sap.ui.model.type.Float', formatOptions:{groupingEnabled:true, minFractionDigits:0, maxFractionDigits:0}}"/>
																<ObjectNumber
																	number="{path:'screen1>POQty', type:'sap.ui.model.type.Float', formatOptions:{groupingEnabled:true, minFractionDigits:0, maxFractionDigits:0}}"/>
																<ObjectNumber
																	number="{path:'screen1>GRNQty', type:'sap.ui.model.type.Float', formatOptions:{groupingEnabled:true, minFractionDigits:0, maxFractionDigits:0}}"/>
															</cells>
														</ColumnListItem>
													</items>
												</Table>
											</ScrollContainer>
										</VBox>
									</HBox>
									<MessageStrip text="Select a period from the table or chart to view the detailed dashboard." type="Information" showIcon="true"
										class="prpoTableHint" visible="{= ${screen1>/hasData} &amp;&amp; !${screen1>/selectedPeriod} }"/>
								</VBox>
							</content>
						</Panel>
						<!-- PANEL 2: PR / PO / GR details for the selected period -->
						<Panel id="detailsPanel" class="prpoCard prpoDetailsPanel" expandable="true" expanded="false" backgroundDesign="Solid"
							accessibleRole="Region">
							<headerToolbar>
								<Toolbar class="prpoCardHeader" style="Clear">
									<core:Icon src="sap-icon://detail-view" class="prpoCardIcon"/>
									<Title text="PR / PO / GR Details Dashboard" level="H2"/>
									<ToolbarSpacer/>
									<SegmentedButton id="detailViewSwitch" selectedKey="{detail>/viewMode}" selectionChange="onDetailViewChange" class="prpoDetailViewSwitch">
										<items>
											<SegmentedButtonItem key="graphical" text="Graphical View" icon="sap-icon://bar-chart"/>
											<SegmentedButtonItem key="table" text="Table View" icon="sap-icon://table-view"/>
										</items>
									</SegmentedButton>
									<ObjectStatus text="{detail>/contextText}" state="Success" inverted="true" class="prpoDetailContextStatus"/>
								</Toolbar>
							</headerToolbar>
							<content>
								<VBox class="prpoDetailContent" busy="{detail>/busy}" busyIndicatorDelay="0">
									<VBox class="prpoDetailEmpty" alignItems="Center" visible="{= !${detail>/selectedPeriod} &amp;&amp; !${detail>/busy} }">
										<core:Icon src="sap-icon://detail-view" size="1.8rem" class="prpoEmptyIcon"/>
										<Text text="Select a period from the table or chart above to load PR / PO / GR details."/>
									</VBox>
									<MessageStrip text="{detail>/errorText}" type="Error" showIcon="true" visible="{= ${detail>/errorText} !== '' }">
										<link><Link text="Retry" press="onRetryDetails"/></link>
									</MessageStrip>
									<MessageStrip text="No PR / PO / GR detail records were found for this period." type="Information" showIcon="true"
										visible="{detail>/noData}"/>
									<MessageStrip text="{detail>/valueWarningText}" type="Warning" showIcon="true"
										visible="{= ${detail>/valueWarningText} !== '' &amp;&amp; ${detail>/hasData} }"/>
									<VBox class="prpoDetailData" visible="{detail>/hasData}">
										<FlexBox id="kpiGrid" class="prpoKpiGrid" items="{detail>/kpis}" wrap="Wrap" renderType="Bare" alignItems="Stretch">
											<items>
												<CustomTile class="prpoKpiCard" press="onKpiPress" tooltip="{= 'Filter table by ' + ${detail>label} }">
													<content>
														<VBox class="prpoKpiCardContent">
															<HBox class="prpoKpiMain" alignItems="Center">
																<core:Icon src="{detail>icon}" class="prpoKpiIcon"/>
																<VBox class="prpoKpiText">
																	<ObjectNumber number="{detail>value}" unit="{detail>unit}"/>
																	<Text text="{detail>label}" class="prpoKpiLabel"/>
																</VBox>
															</HBox>
															<Text text="{detail>hint}" class="prpoKpiHint"/>
														</VBox>
													</content>
												</CustomTile>
											</items>
										</FlexBox>
										<VBox id="detailGraphicalView" class="prpoDetailGraphicalView" visible="{= ${detail>/viewMode} === 'graphical' }">
											<HBox class="prpoDetailChartRow" wrap="Wrap" renderType="Bare">
												<VBox class="prpoDetailChartCard">
													<HBox class="prpoDetailChartHeading" alignItems="Center">
														<core:Icon src="sap-icon://process"/>
														<Title text="Procurement Pipeline (PR Lines)" level="H3"/>
													</HBox>
													<cc:ChartContainer id="detailPipelineContainer" width="100%" height="20rem" autoAdjustHeight="true" showFullScreen="true" showZoom="true"
														showPersonalization="false" showLegend="false" showLegendButton="false">
														<cc:content>
															<cc:ChartContainerContent icon="sap-icon://process" title="Procurement Pipeline (PR Lines)">
																<cc:content>
																	<viz:VizFrame id="detailPipelineChart" vizType="bar" width="100%" height="16rem" uiConfig="{applicationSet:'fiori'}"
																		renderComplete="onDetailChartRenderComplete">
																		<viz:dataset>
																			<viz.data:FlattenedDataset data="{detail>/pipeline}">
																				<viz.data:dimensions><viz.data:DimensionDefinition name="Status" value="{detail>Status}"/></viz.data:dimensions>
																				<viz.data:measures><viz.data:MeasureDefinition name="PR Lines" value="{detail>PRLines}"/></viz.data:measures>
																			</viz.data:FlattenedDataset>
																		</viz:dataset>
																		<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PR Lines"/>
																			<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Status"/></viz:feeds>
																	</viz:VizFrame>
																</cc:content>
															</cc:ChartContainerContent>
														</cc:content>
													</cc:ChartContainer>
												</VBox>
												<VBox class="prpoDetailChartCard">
													<HBox class="prpoDetailChartHeading" alignItems="Center">
														<core:Icon src="sap-icon://history"/>
														<Title text="PR – PO Lead Time (Days)" level="H3"/>
													</HBox>
													<cc:ChartContainer id="detailLeadTimeContainer" width="100%" height="23rem" autoAdjustHeight="false" showFullScreen="true" showZoom="true"
														showPersonalization="false" showLegend="false" showLegendButton="false">
														<cc:content>
															<cc:ChartContainerContent icon="sap-icon://history" title="PR – PO Lead Time (Days)">
																<cc:content>
																	<viz:VizFrame id="detailLeadTimeChart" vizType="bar" width="100%" height="19rem" uiConfig="{applicationSet:'fiori'}"
																		renderComplete="onDetailChartRenderComplete">
																		<viz:dataset>
																			<viz.data:FlattenedDataset data="{detail>/leadTime}">
																				<viz.data:dimensions><viz.data:DimensionDefinition name="Bucket" value="{detail>Bucket}"/></viz.data:dimensions>
																				<viz.data:measures><viz.data:MeasureDefinition name="PR Lines" value="{detail>PRLines}"/></viz.data:measures>
																			</viz.data:FlattenedDataset>
																		</viz:dataset>
																		<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PR Lines"/>
																			<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Bucket"/></viz:feeds>
																	</viz:VizFrame>
																</cc:content>
															</cc:ChartContainerContent>
														</cc:content>
													</cc:ChartContainer>
												</VBox>
											</HBox>
											<HBox class="prpoDetailChartRow" wrap="Wrap" renderType="Bare">
												<VBox class="prpoDetailChartCard">
													<HBox class="prpoDetailChartHeading" alignItems="Center">
														<core:Icon src="sap-icon://bar-chart"/>
														<Title text="{detail>/monthlyChartTitle}" level="H3"/>
													</HBox>
													<cc:ChartContainer id="detailMonthlyValueContainer" width="100%" height="20rem" autoAdjustHeight="true" showFullScreen="true"
														showZoom="true" showPersonalization="false" showLegend="false" showLegendButton="false">
														<cc:content>
															<cc:ChartContainerContent icon="sap-icon://bar-chart" title="{detail>/monthlyChartTitle}">
																<cc:content>
																	<viz:VizFrame id="detailMonthlyValueChart" vizType="column" width="100%" height="16rem" uiConfig="{applicationSet:'fiori'}"
																		renderComplete="onDetailChartRenderComplete">
																		<viz:dataset>
																			<viz.data:FlattenedDataset data="{detail>/monthlyValue}">
																				<viz.data:dimensions><viz.data:DimensionDefinition name="Month" value="{detail>Month}"/></viz.data:dimensions>
																				<viz.data:measures>
																					<viz.data:MeasureDefinition name="No PO Yet Value" value="{detail>NoPOYetValue}"/>
																					<viz.data:MeasureDefinition name="PO-Awaiting GR Value" value="{detail>POAwaitingGRValue}"/>
																					<viz.data:MeasureDefinition name="PO-GR Partial Value" value="{detail>POGRPartialValue}"/>
																					<viz.data:MeasureDefinition name="Fully Received Value" value="{detail>FullyReceivedValue}"/>
																				</viz.data:measures>
																			</viz.data:FlattenedDataset>
																		</viz:dataset>
																		<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="No PO Yet Value,PO-Awaiting GR Value,PO-GR Partial Value,Fully Received Value"/>
																			<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Month"/></viz:feeds>
																	</viz:VizFrame>
																</cc:content>
															</cc:ChartContainerContent>
														</cc:content>
													</cc:ChartContainer>
													<HBox class="prpoDetailLegend" justifyContent="Center" alignItems="Center" wrap="Wrap">
														<HBox class="prpoDetailLegendItem" alignItems="Center">
															<core:Icon src="sap-icon://circle-task-2" class="prpoDetailLegendSwatch prpoDetailLegendNoPO"/>
															<Text text="No PO Yet"/>
														</HBox>
														<HBox class="prpoDetailLegendItem" alignItems="Center">
															<core:Icon src="sap-icon://circle-task-2" class="prpoDetailLegendSwatch prpoDetailLegendAwaiting"/>
															<Text text="PO-Awaiting GR"/>
														</HBox>
														<HBox class="prpoDetailLegendItem" alignItems="Center">
															<core:Icon src="sap-icon://circle-task-2" class="prpoDetailLegendSwatch prpoDetailLegendPartial"/>
															<Text text="PO – GR Partial"/>
														</HBox>
														<HBox class="prpoDetailLegendItem" alignItems="Center">
															<core:Icon src="sap-icon://circle-task-2" class="prpoDetailLegendSwatch prpoDetailLegendReceived"/>
															<Text text="Fully Received"/>
														</HBox>
													</HBox>
												</VBox>
												<VBox class="prpoDetailChartCard">
													<HBox class="prpoDetailChartHeading" alignItems="Center">
														<core:Icon src="sap-icon://trophy"/>
														<Title text="{detail>/topVendorsChartTitle}" level="H3"/>
													</HBox>
													<cc:ChartContainer id="detailTopVendorsContainer" width="100%" height="20rem" autoAdjustHeight="true" showFullScreen="true" showZoom="true"
														showPersonalization="false" showLegend="false" showLegendButton="false">
														<cc:content>
															<cc:ChartContainerContent icon="sap-icon://trophy" title="{detail>/topVendorsChartTitle}">
																<cc:content>
																	<viz:VizFrame id="detailTopVendorsChart" vizType="bar" width="100%" height="16rem" uiConfig="{applicationSet:'fiori'}"
																		renderComplete="onDetailChartRenderComplete">
																		<viz:dataset>
																			<viz.data:FlattenedDataset data="{detail>/topVendors}">
																				<viz.data:dimensions><viz.data:DimensionDefinition name="Vendor" value="{detail>Vendor}"/></viz.data:dimensions>
																				<viz.data:measures><viz.data:MeasureDefinition name="PR Value" value="{detail>PRValue}"/></viz.data:measures>
																			</viz.data:FlattenedDataset>
																		</viz:dataset>
																		<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PR Value"/>
																			<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Vendor"/></viz:feeds>
																	</viz:VizFrame>
																</cc:content>
															</cc:ChartContainerContent>
														</cc:content>
													</cc:ChartContainer>
												</VBox>
											</HBox>
										</VBox>
										<VBox id="detailTableSection" class="prpoDetailTableCard" visible="{= ${detail>/viewMode} === 'table' }">
											<Toolbar class="prpoDetailTableToolbar" style="Clear">
												<core:Icon src="sap-icon://table-view" class="prpoCardIcon"/>
												<Title text="PR / PO / GR Hierarchy" level="H3"/>
												<ObjectStatus text="{detail>/tableSummaryText}" state="Information"/>
												<!--<Text text="{= ${detail>/activeKpiText} ? 'Filtered by: ' + ${detail>/activeKpiText} : '' }"-->
												<!--	visible="{= !!${detail>/activeKpiText} }" class="prpoDetailActiveFilter"/>-->
												<ToolbarSpacer/>
												<SearchField id="detailSearch" width="18rem" placeholder="Search PR, PO, vendor, material..." value="{detail>/searchQuery}"
													liveChange="onDetailSearch" search="onDetailSearch"/>
												<Button text="Clear Filters" icon="sap-icon://clear-filter" visible="{detail>/hasTableFilters}" press="onClearDetailTableFilters"/>
												<Button text="Export Excel" icon="sap-icon://excel-attachment" press="onExportDetailTable"/>
											</Toolbar>
											<Text text="Expand a PR item to view its related PO items and distinct GR document items." class="prpoTreeHint"/>
											<table:TreeTable id="detailsTable" rows="{path: 'detail>/visibleTreeRows', parameters: {arrayNames: ['children']}}" visibleRowCount="8"
												rowHeight="38" expandFirstLevel="false" fixedColumnCount="1" selectionMode="None" enableColumnReordering="true" alternateRowColors="true"
												width="100%" class="prpoDetailsGridTable">
												<table:noData><Text text="No detail rows match the current filters."/></table:noData>
												<table:columns>
													<table:Column width="19rem" sortProperty="NodeLabel"><Label text="PR / PO / GR"/>
